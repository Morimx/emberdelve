[resource]
script = ExtResource("1_dungeon")
id = &"sunken_forge"
display_name = "Sunken Forge"
description = "Embers still burn below. Only the strongest return."
enemies = Array[ExtResource("2_enemy")]([ExtResource("e1"), ExtResource("e2"), ExtResource("e3"), ExtResource("e4")])
