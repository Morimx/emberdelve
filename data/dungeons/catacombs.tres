[resource]
script = ExtResource("1_dungeon")
id = &"catacombs"
display_name = "Catacombs"
description = "Bones, bats and slime. Where every delve begins."
enemies = Array[ExtResource("2_enemy")]([ExtResource("e1"), ExtResource("e2"), ExtResource("e3"), ExtResource("e4")])
boss = ExtResource("b1")
difficulty = 1.0
boss_power = 1.5
boss_shards = 3
unlock_after = &""
biome = &"catacombs"
wall_tint = Color(0.8, 0.8, 0.95, 1)
floor_color = Color(0.078, 0.102, 0.239, 1)
