[gd_resource type="Resource" script_class="DungeonData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/data/dungeon_data.gd" id="1_dungeon"]
[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="2_enemy"]
